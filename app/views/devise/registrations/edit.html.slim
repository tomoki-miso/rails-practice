h2 = "#{resource_name.to_s.humanize}情報の編集"

= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f|
  = render "devise/shared/error_messages", resource: resource

  .mb-3
    = f.label :name, "名前", class: "form-label"
    = f.text_field :name, autofocus: true, class: "form-control"

  .mb-3
    = f.label :email, "メールアドレス", class: "form-label"
    = f.email_field :email, autocomplete: "email", class: "form-control"

  - if devise_mapping.confirmable? && resource.pending_reconfirmation?
    .mb-3 = "現在確認待ちのメールアドレス: #{resource.unconfirmed_email}"

  .mb-3
    = f.label :password, "パスワード", class: "form-label"
    small.text-muted  （変更しない場合は空欄）
    = f.password_field :password, autocomplete: "new-password", class: "form-control"
    - if @minimum_password_length
      small.text-muted  （#{@minimum_password_length}文字以上）

  .mb-3
    = f.label :password_confirmation, "パスワード（確認）", class: "form-label"
    = f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control"

  .mb-3
    = f.label :current_password, "現在のパスワード", class: "form-label"
    small.text-muted  （変更の確認に必要です）
    = f.password_field :current_password, autocomplete: "current-password", class: "form-control"

  .mb-3
    = f.submit "更新", class: "btn btn-primary"

h3 アカウントの削除

div
  | 退会しますか？
  = button_to "アカウントを削除", registration_path(resource_name), data: { confirm: "本当によろしいですか？", turbo_confirm: "本当によろしいですか？" }, method: :delete, class: "btn btn-danger btn-sm"

= link_to "戻る", :back
